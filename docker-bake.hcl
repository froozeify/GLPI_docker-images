# Build definition of the PHP images that share the `githubactions-base` layers.
#
# Dockerfiles have no `INCLUDE` instruction, so the child images use `FROM base` and Bake maps `base` to the
# `githubactions-base-*` targets (see `contexts`). The base images are built in the same build graph and are never
# published.
#
# Usage:
#   docker buildx bake githubactions-php-apache-8-5   # one image
#   docker buildx bake githubactions-php-apache       # same image for all PHP versions
#   docker buildx bake glpi --set glpi.tags=glpi:local --load   # GLPI image (see GLPI_* variables)
#   docker buildx bake --print                        # show the resolved configuration

#####
# Shared variables and functions
#####
variable "GHCR_NAMESPACE" {
  default = "ghcr.io/glpi-project"
}

variable "PHP_VERSIONS" {
  default = ["8.2", "8.3", "8.4", "8.5", "8.6"]
}

# PHP version of the images that also get the `latest` tag.
variable "LATEST_PHP_VERSION" {
  default = "8.5"
}

# Enables the GitHub Actions cache (used by CI only).
variable "GHA_CACHE" {
  default = false
}

# Suffix appended to the cache scopes, to isolate caches that must not be shared (e.g. the CPU architecture).
variable "CACHE_SUFFIX" {
  default = ""
}

# Docker tag of the official PHP image for each PHP version (PHP 8.6 is not released yet).
function "php_tag" {
  params = [version]
  result = version == "8.6" ? "8.6-rc" : version
}

# Version as used in target names (8.5 => 8-5).
function "slug" {
  params = [version]
  result = replace(version, ".", "-")
}

# GitHub Actions cache settings of a target. Each target must have its own scope, otherwise they overwrite each other's
# cache. The scope of a base target is the same for all the workflows that use it, so that they share its layers.
function "gha_cache_from" {
  params = [scope]
  result = GHA_CACHE ? ["type=gha,scope=${scope}${CACHE_SUFFIX}"] : []
}

function "gha_cache_to" {
  params = [scope]
  result = GHA_CACHE ? ["type=gha,mode=max,scope=${scope}${CACHE_SUFFIX}"] : []
}

# Overridden in CI by the file generated by `docker/metadata-action` (labels).
target "docker-metadata-action" {}

#####
# PHP images
#####
target "githubactions-base" {
  name       = "githubactions-base-${flavor}-${slug(php)}"
  matrix     = {
    flavor = ["fpm", "apache"]
    php    = PHP_VERSIONS
  }
  context    = "githubactions-base"
  args       = {
    BASE_IMAGE = "php:${php_tag(php)}-${flavor}-trixie"
    FLAVOR     = flavor
  }
  pull       = true
  cache-from = gha_cache_from("githubactions-base-${flavor}-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-base-${flavor}-${slug(php)}")
}

target "githubactions-php" {
  name       = "githubactions-php-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php"
  contexts   = {
    base = "target:githubactions-base-fpm-${slug(php)}"
  }
  tags       = ["${GHCR_NAMESPACE}/githubactions-php:${php}"]
  cache-from = gha_cache_from("githubactions-php-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-${slug(php)}")
}

target "githubactions-php-apache" {
  name       = "githubactions-php-apache-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php-apache"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  target     = "main"
  tags       = ["${GHCR_NAMESPACE}/githubactions-php-apache:${php}"]
  cache-from = gha_cache_from("githubactions-php-apache-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-apache-${slug(php)}")
}

target "githubactions-php-apache-playwright" {
  name       = "githubactions-php-apache-playwright-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php-apache"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  target     = "playwright"
  tags       = ["${GHCR_NAMESPACE}/githubactions-php-apache:${php}-playwright"]
  cache-from = gha_cache_from("githubactions-php-apache-playwright-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-apache-playwright-${slug(php)}")
}

target "glpi-development-env" {
  name       = "glpi-development-env-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  inherits   = ["docker-metadata-action"]
  context    = "glpi-development-env"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  tags       = ["${GHCR_NAMESPACE}/glpi-development-env:${php}"]
  cache-from = gha_cache_from("glpi-development-env-${slug(php)}")
  cache-to   = gha_cache_to("glpi-development-env-${slug(php)}")
}

#####
# GLPI plugins images (PHP/Apache image of the matching PHP version with a build of a GLPI branch)
#####
function "glpi_apache_tags" {
  params = [php, version]
  result = concat(
    ["${GHCR_NAMESPACE}/githubactions-glpi-apache:php-${php}-glpi-${version}"],
    version == "11.0.x" && php == LATEST_PHP_VERSION ? ["${GHCR_NAMESPACE}/githubactions-glpi-apache:latest"] : [],
  )
}

# GLPI branches with the PHP versions they are built for, expanded to one entry per GLPI branch and PHP version.
variable "GLPI_APACHE_MATRIX" {
  default = flatten([
    for glpi in [
      { branch = "11.0/bugfixes", version = "11.0.x", php = ["8.2", "8.3", "8.4", "8.5"] },
      { branch = "12.0/bugfixes", version = "12.0.x", php = ["8.3", "8.4", "8.5"] },
      { branch = "main", version = "13.0.x", php = ["8.3", "8.4", "8.5"] },
    ] : [
      for php in glpi.php : { branch = glpi.branch, version = glpi.version, php = php }
    ]
  ])
}

target "githubactions-glpi-apache" {
  name     = "githubactions-glpi-apache-glpi-${slug(item.version)}-php-${slug(item.php)}"
  matrix   = {
    item = GLPI_APACHE_MATRIX
  }
  context  = "githubactions-glpi-apache"
  contexts = {
    base = "target:githubactions-php-apache-playwright-${slug(item.php)}"
  }
  args     = {
    GLPI_BRANCH = item.branch
    CACHE_BUST  = timestamp()
  }
  tags     = glpi_apache_tags(item.php, item.version)
  pull     = true
}

#####
# GLPI image (published by digest, the tags are applied afterwards by the `glpi` workflow)
#####

# GitHub repository to download GLPI from.
variable "GLPI_REPO" {
  default = "glpi-project/glpi"
}

# "latest", a tag (10.0.18), a branch (main, 11.0/bugfixes), a commit hash or a URL.
variable "GLPI_VERSION" {
  default = "latest"
}

# Space-separated URLs to .diff/.patch files to apply on the sources.
variable "GLPI_PATCH_URL" {
  default = ""
}

# Cache-busting key, to rebuild the sources layer when the targeted commit changed.
variable "GLPI_CACHE_KEY" {
  default = ""
}

# `/var/www/glpi/marketplace` must be used for GLPI 10.x.
variable "GLPI_MARKETPLACE_DIR" {
  default = "/var/glpi/marketplace"
}

variable "GLPI_PHP_VERSION" {
  default = LATEST_PHP_VERSION
}

target "glpi" {
  inherits   = ["docker-metadata-action"]
  context    = "glpi"
  contexts   = {
    php-scripts = "githubactions-base/scripts"
  }
  args       = {
    GLPI_REPO            = GLPI_REPO
    GLPI_VERSION         = GLPI_VERSION
    GLPI_PATCH_URL       = GLPI_PATCH_URL
    GLPI_CACHE_KEY       = GLPI_CACHE_KEY
    GLPI_MARKETPLACE_DIR = GLPI_MARKETPLACE_DIR
    BUILDER_IMAGE        = "php:${GLPI_PHP_VERSION}-cli-alpine"
    APP_IMAGE            = "php:${GLPI_PHP_VERSION}-apache"
  }
  pull       = true
}

#####
# Database images
#####
target "githubactions-db" {
  name       = "githubactions-${db.engine}-${slug(db.version)}"
  matrix     = {
    db = [
      { engine = "mariadb", version = "10.11" },
      { engine = "mariadb", version = "11.4" },
      { engine = "mariadb", version = "11.8" },
      { engine = "mariadb", version = "12.3" },
      { engine = "mysql", version = "8.4" },
      { engine = "mysql", version = "9.7" },
    ]
  }
  context    = "githubactions-db"
  args       = {
    BASE_IMAGE = "${db.engine}:${db.version}"
    CONFIG_DIR = "/etc/mysql/conf.d"
  }
  tags       = ["${GHCR_NAMESPACE}/githubactions-${db.engine}:${db.version}"]
  pull       = true
  cache-from = gha_cache_from("githubactions-${db.engine}-${slug(db.version)}")
  cache-to   = gha_cache_to("githubactions-${db.engine}-${slug(db.version)}")
}

#####
# Service images
#####
target "githubactions-service" {
  name       = "githubactions-${service.name}"
  matrix     = {
    service = [
      { name = "redis", base = "redis" },
      { name = "memcached", base = "memcached" },
      { name = "openldap", base = "alpine" },
    ]
  }
  context    = "githubactions-${service.name}"
  args       = {
    BASE_IMAGE = service.base
  }
  tags       = ["${GHCR_NAMESPACE}/githubactions-${service.name}:latest"]
  pull       = true
  cache-from = gha_cache_from("githubactions-${service.name}")
  cache-to   = gha_cache_to("githubactions-${service.name}")
}

# Images that do not take a base image argument.
target "githubactions-dovecot" {
  context    = "githubactions-dovecot"
  tags       = ["${GHCR_NAMESPACE}/githubactions-dovecot:latest"]
  pull       = true
  cache-from = gha_cache_from("githubactions-dovecot")
  cache-to   = gha_cache_to("githubactions-dovecot")
}

target "plugin-builder" {
  context    = "plugin-builder"
  tags       = ["${GHCR_NAMESPACE}/plugin-builder:latest"]
  pull       = true
  cache-from = gha_cache_from("plugin-builder")
  cache-to   = gha_cache_to("plugin-builder")
}

group "services" {
  targets = [
    "githubactions-service",
    "githubactions-dovecot",
    "plugin-builder",
  ]
}

group "default" {
  targets = [
    "githubactions-php",
    "githubactions-php-apache",
    "githubactions-php-apache-playwright",
    "glpi-development-env",
  ]
}
