# Build definition of the PHP images that share the `githubactions-base` layers.
#
# Dockerfiles have no `INCLUDE` instruction, so the child images use `FROM base` and Bake maps `base` to the
# `githubactions-base-*` targets (see `contexts`). The base images are built in the same build graph and are never
# published.
#
# Usage:
#   docker buildx bake githubactions-php-apache-8-5   # one image
#   docker buildx bake githubactions-php-apache       # same image for all PHP versions
#   docker buildx bake --print                        # show the resolved configuration

#####
# Shared variables and functions
#####
variable "GHCR_NAMESPACE" {
  default = "ghcr.io/glpi-project"
}

variable "PHP_VERSIONS" {
  default = ["8.2", "8.3", "8.4", "8.5", "8.6"]
}

# PHP version of the images that also get the `latest` tag.
variable "LATEST_PHP_VERSION" {
  default = "8.5"
}

# Enables the GitHub Actions cache (used by CI only).
variable "GHA_CACHE" {
  default = false
}

# Suffix appended to the cache scopes, to isolate caches that must not be shared (e.g. the CPU architecture).
variable "CACHE_SUFFIX" {
  default = ""
}

# Docker tag of the official PHP image for each PHP version (PHP 8.6 is not released yet).
function "php_tag" {
  params = [version]
  result = version == "8.6" ? "8.6-rc" : version
}

# Version as used in target names (8.5 => 8-5).
function "slug" {
  params = [version]
  result = replace(version, ".", "-")
}

# GitHub Actions cache settings of a target. Each target must have its own scope, otherwise they overwrite each other's
# cache. The scope of a base target is the same for all the workflows that use it, so that they share its layers.
function "gha_cache_from" {
  params = [scope]
  result = GHA_CACHE ? ["type=gha,scope=${scope}${CACHE_SUFFIX}"] : []
}

function "gha_cache_to" {
  params = [scope]
  result = GHA_CACHE ? ["type=gha,mode=max,scope=${scope}${CACHE_SUFFIX}"] : []
}

# Overridden in CI by the file generated by `docker/metadata-action` (labels).
target "docker-metadata-action" {}

#####
# PHP images
#####
target "githubactions-base" {
  name       = "githubactions-base-${flavor}-${slug(php)}"
  matrix     = {
    flavor = ["fpm", "apache"]
    php    = PHP_VERSIONS
  }
  context    = "githubactions-base"
  args       = {
    BASE_IMAGE = "php:${php_tag(php)}-${flavor}-trixie"
    FLAVOR     = flavor
  }
  pull       = true
  cache-from = gha_cache_from("githubactions-base-${flavor}-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-base-${flavor}-${slug(php)}")
}

target "githubactions-php" {
  name       = "githubactions-php-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php"
  contexts   = {
    base = "target:githubactions-base-fpm-${slug(php)}"
  }
  tags       = ["${GHCR_NAMESPACE}/githubactions-php:${php}"]
  cache-from = gha_cache_from("githubactions-php-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-${slug(php)}")
}

target "githubactions-php-apache" {
  name       = "githubactions-php-apache-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php-apache"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  target     = "main"
  tags       = ["${GHCR_NAMESPACE}/githubactions-php-apache:${php}"]
  cache-from = gha_cache_from("githubactions-php-apache-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-apache-${slug(php)}")
}

target "githubactions-php-apache-playwright" {
  name       = "githubactions-php-apache-playwright-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  context    = "githubactions-php-apache"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  target     = "playwright"
  tags       = ["${GHCR_NAMESPACE}/githubactions-php-apache:${php}-playwright"]
  cache-from = gha_cache_from("githubactions-php-apache-playwright-${slug(php)}")
  cache-to   = gha_cache_to("githubactions-php-apache-playwright-${slug(php)}")
}

target "glpi-development-env" {
  name       = "glpi-development-env-${slug(php)}"
  matrix     = {
    php = PHP_VERSIONS
  }
  inherits   = ["docker-metadata-action"]
  context    = "glpi-development-env"
  contexts   = {
    base = "target:githubactions-base-apache-${slug(php)}"
  }
  tags       = ["${GHCR_NAMESPACE}/glpi-development-env:${php}"]
  cache-from = gha_cache_from("glpi-development-env-${slug(php)}")
  cache-to   = gha_cache_to("glpi-development-env-${slug(php)}")
}

group "default" {
  targets = [
    "githubactions-php",
    "githubactions-php-apache",
    "githubactions-php-apache-playwright",
    "glpi-development-env",
  ]
}
